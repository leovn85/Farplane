<Controls:MetroWindow
    x:Class="Farplane.Common.Dialogs.GamePatcherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Farplane - Integrated Game Patcher &amp; Mods Setup"
    Width="720"
    Height="600"
    BorderThickness="0"
    GlowBrush="Black"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    mc:Ignorable="d"
>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: DIRECTORY SELECTOR -->
        <GroupBox Grid.Row="0" Header="Game Installation Directory" Margin="0,0,0,10">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Name="TextGamePath"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    IsReadOnly="True"
                />
                <Button
                    Name="ButtonBrowse"
                    Grid.Column="1"
                    Content="Browse..."
                    Margin="0,0,6,0"
                    Padding="12,4"
                    Click="ButtonBrowse_Click"
                />
                <Button
                    Name="ButtonAutoDetect"
                    Grid.Column="2"
                    Content="Auto Detect"
                    Padding="12,4"
                    Click="ButtonAutoDetect_Click"
                />
            </Grid>
        </GroupBox>

        <!-- CENTER: MOD MODULES CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">

                <!-- 1. 4GB PATCH (LAA) -->
                <GroupBox Header="1. 4GB Memory Patch (Large Address Aware)" Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <TextBlock
                            Text="Expands 32-bit memory address space from 2GB to 4GB. Crucial to prevent random out-of-memory crashes when using 4K textures, Project X, or heavy assets."
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource GrayBrush1}"
                            Margin="0,0,0,8"
                        />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="4">
                                <CheckBox
                                    Name="Check4GB_FFX"
                                    Content="Patch FFX.exe"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Name="Status4GB_FFX"
                                    Text="[Unknown]"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="4">
                                <CheckBox
                                    Name="Check4GB_FFX2"
                                    Content="Patch FFX-2.exe"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Name="Status4GB_FFX2"
                                    Text="[Unknown]"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 2. FARPLANE FIX -->
                <GroupBox Header="2. Farplane Background Video Fix" Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <TextBlock
                            Text="Fixes the grey sky background bug at the Farplane (Guadosalam) on PC Steam so the background video streams and visual effects play as originally designed."
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource GrayBrush1}"
                            Margin="0,0,0,8"
                        />
                        <DockPanel Margin="4">
                            <CheckBox
                                Name="CheckFarplane_FFX"
                                Content="Enable Farplane Video Fix (FFX.exe)"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Name="StatusFarplane_FFX"
                                Text="[Unknown]"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                            />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 3. JAPANESE AUDIO (UNDUB MOD) -->
                <GroupBox Header="3. Japanese Audio Mod (Undub)" Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <TextBlock
                            Text="Redirects internal audio streams to play high-quality Japanese voice tracks while retaining English interface text and subtitles."
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource GrayBrush1}"
                            Margin="0,0,0,8"
                        />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="4">
                                <CheckBox
                                    Name="CheckUndub_FFX"
                                    Content="FFX.exe"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Name="StatusUndub_FFX"
                                    Text="[Unknown]"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="4">
                                <CheckBox
                                    Name="CheckUndub_FFX2"
                                    Content="FFX-2.exe"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Name="StatusUndub_FFX2"
                                    Text="[Unknown]"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <DockPanel Grid.Column="2" Margin="4">
                                <CheckBox
                                    Name="CheckUndub_Will"
                                    Content="FFX-Will"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Name="StatusUndub_Will"
                                    Text="[Unknown]"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM CONTROLS & ACTIONS -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button
                Name="ButtonRestore"
                Content="Restore Clean Original"
                DockPanel.Dock="Left"
                Padding="12,6"
                Click="ButtonRestore_Click"
            />
            <Button
                Name="ButtonRefresh"
                Content="Refresh Status"
                DockPanel.Dock="Left"
                Margin="6,0,0,0"
                Padding="12,6"
                Click="ButtonRefresh_Click"
            />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Name="ButtonApply"
                    Content="Apply Selected Patches"
                    Style="{DynamicResource AccentedSquareButtonStyle}"
                    FontWeight="SemiBold"
                    Padding="16,6"
                    Click="ButtonApply_Click"
                />
                <Button
                    Name="ButtonClose"
                    Content="Close"
                    Margin="8,0,0,0"
                    Padding="14,6"
                    Click="ButtonClose_Click"
                />
            </StackPanel>
        </DockPanel>
    </Grid>
</Controls:MetroWindow>
