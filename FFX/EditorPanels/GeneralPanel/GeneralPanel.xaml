<UserControl
    x:Class="Farplane.FFX.EditorPanels.GeneralPanel.GeneralPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="520"
    d:DesignWidth="480"
    mc:Ignorable="d"
>
    <GroupBox Header="General">
        <TabControl Margin="0" Padding="0">
            <!-- TAB 1: Overview & Party -->
            <TabItem Header="Overview &amp; Party">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                        <StackPanel>
                            <GroupBox Header="Save State &amp; Progress">
                                <StackPanel Margin="2">
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Gil</TextBlock>
                                        <Button Margin="4,0,0,0" DockPanel.Dock="Right" Content="MAX" Click="ButtonMaxGil_Click" Width="36" />
                                        <TextBox
                                            Name="TextGil"
                                            Width="90"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextGil_OnKeyDown"
                                        />
                                    </DockPanel>
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Tidus Overdrive Uses</TextBlock>
                                        <TextBox
                                            Name="TextTidusOverdrive"
                                            Width="60"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextTidusOverdrive_OnKeyDown"
                                        />
                                    </DockPanel>
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Total Battles Fought</TextBlock>
                                        <TextBox
                                            Name="TextTotalBattles"
                                            Width="60"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextTotalBattles_OnKeyDown"
                                        />
                                    </DockPanel>
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Story Progress ID</TextBlock>
                                        <TextBox
                                            Name="TextStoryProgress"
                                            Width="60"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextStoryProgress_OnKeyDown"
                                        />
                                    </DockPanel>
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Successful Steals</TextBlock>
                                        <TextBox
                                            Name="TextRikkuSteals"
                                            Width="60"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextRikkuSteals_OnKeyDown"
                                        />
                                    </DockPanel>
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Bribe Gil Spent</TextBlock>
                                        <TextBox
                                            Name="TextBribeGil"
                                            Width="90"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextBribeGil_OnKeyDown"
                                        />
                                    </DockPanel>
                                    <DockPanel Margin="2">
                                        <TextBlock VerticalAlignment="Center" Margin="2">Yojimbo Compatibility</TextBlock>
                                        <TextBox
                                            Name="TextYojimboCompat"
                                            Width="50"
                                            HorizontalAlignment="Right"
                                            KeyDown="TextYojimboCompat_OnKeyDown"
                                            ToolTip="Default is 128 (Range 0 - 255)"
                                        />
                                    </DockPanel>
                                    <CheckBox
                                        Name="CheckRikkuCostume"
                                        Margin="2,6,2,2"
                                        Content="Rikku Al Bhed Costume"
                                        Checked="CheckRikkuCostume_Changed"
                                        Unchecked="CheckRikkuCostume_Changed"
                                    />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <GroupBox Grid.Column="1" Header="Current Party">
                        <StackPanel Name="StackCurrentParty" Margin="2">
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                            <ComboBox Margin="1" SelectionChanged="PartyMember_SelectionChanged" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: Minigames -->
            <TabItem Header="Minigames">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <GroupBox Header="Thunder Plains - Lightning Dodging">
                            <StackPanel Margin="2">
                                <DockPanel Margin="2">
                                    <TextBlock VerticalAlignment="Center" Margin="2">Total Lightning Bolts</TextBlock>
                                    <TextBox Name="TextLightningAll" Width="60" HorizontalAlignment="Right" KeyDown="TextLightningAll_OnKeyDown" />
                                </DockPanel>
                                <DockPanel Margin="2">
                                    <TextBlock VerticalAlignment="Center" Margin="2">Total Bolts Dodged</TextBlock>
                                    <TextBox Name="TextLightningDodged" Width="60" HorizontalAlignment="Right" KeyDown="TextLightningDodged_OnKeyDown" />
                                </DockPanel>
                                <DockPanel Margin="2">
                                    <TextBlock VerticalAlignment="Center" Margin="2">Record Consecutive Streak</TextBlock>
                                    <TextBox Name="TextLightningStreak" Width="60" HorizontalAlignment="Right" KeyDown="TextLightningStreak_OnKeyDown" />
                                </DockPanel>
                                <Button
                                    Name="ButtonCompleteLightning"
                                    Margin="2,6,2,2"
                                    Content="Complete 200 Dodges (Venus Sigil)"
                                    Click="ButtonCompleteLightning_Click"
                                />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Chocobo Catcher (Calm Lands)" Margin="0,4,0,0">
                            <StackPanel Margin="2">
                                <Button
                                    Name="ButtonWinChocobo"
                                    Margin="2"
                                    Content="Win Race Now (0:0.0 / 50 Balloons / 0 Hits)"
                                    Click="ButtonWinChocobo_Click"
                                />
                                <CheckBox
                                    Name="CheckFreezeChocoboTimer"
                                    Margin="2,6,2,2"
                                    Content="Freeze Race Timer at 0.0s (Auto-Loop)"
                                    Checked="CheckFreezeChocoboTimer_Changed"
                                    Unchecked="CheckFreezeChocoboTimer_Changed"
                                />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Blitzball Match Helper" Margin="0,4,0,0">
                            <StackPanel Margin="2">
                                <Button
                                    Name="ButtonFastWinBlitzball"
                                    Margin="2"
                                    Content="Fast Win Match (+1 Goal &amp; Jump to End)"
                                    Click="ButtonFastWinBlitzball_Click"
                                />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Luca Theater Spheres" Margin="0,4,0,0">
                            <StackPanel Margin="2">
                                <DockPanel Margin="2">
                                    <TextBlock VerticalAlignment="Center" Margin="2">Music Spheres (0 - 71)</TextBlock>
                                    <Button DockPanel.Dock="Right" Content="MAX" Margin="4,0,0,0" Width="36" Click="ButtonMaxMusic_Click" />
                                    <TextBox Name="TextMusicSpheres" Width="45" HorizontalAlignment="Right" KeyDown="TextMusicSpheres_KeyDown" />
                                </DockPanel>
                                <DockPanel Margin="2">
                                    <TextBlock VerticalAlignment="Center" Margin="2">Movie Spheres (0 - 50)</TextBlock>
                                    <Button DockPanel.Dock="Right" Content="MAX" Margin="4,0,0,0" Width="36" Click="ButtonMaxMovie_Click" />
                                    <TextBox Name="TextMovieSpheres" Width="45" HorizontalAlignment="Right" KeyDown="TextMovieSpheres_KeyDown" />
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,4,0,2">
                                    <Button Name="ButtonUnlockAllMusic" Margin="2" Content="Unlock 71 Songs" Click="ButtonUnlockAllMusic_Click" />
                                    <Button Name="ButtonUnlockAllMovie" Margin="2" Content="Unlock 50 Movies" Click="ButtonUnlockAllMovie_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Temple Seals (Anima) -->
            <TabItem Header="Temple Seals (Anima)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock
                            Text="Destruction Sphere treasure seals required to unlock Aeon Anima at Baaj Temple:"
                            TextWrapping="Wrap"
                            Margin="4,2,4,8"
                            Foreground="{DynamicResource GrayBrush1}"
                        />
                        <CheckBox Name="CheckSeal0" Content="Besaid Temple Seal" Tag="0" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <CheckBox Name="CheckSeal1" Content="Kilika Temple Seal" Tag="1" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <CheckBox Name="CheckSeal2" Content="Djose Temple Seal" Tag="2" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <CheckBox Name="CheckSeal3" Content="Macalania Temple Seal" Tag="3" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <CheckBox Name="CheckSeal4" Content="Bevelle Temple Seal" Tag="4" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <CheckBox Name="CheckSeal5" Content="Zanarkand Dome Seal" Tag="5" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <CheckBox Name="CheckSeal6" Content="Baaj Temple Seal" Tag="6" Margin="4,3" Checked="SealCheckBox_Changed" Unchecked="SealCheckBox_Changed" />
                        <Button
                            Name="ButtonUnlockAllSeals"
                            Margin="4,10,4,4"
                            Content="Unlock All 7 Temple Seals"
                            Click="ButtonUnlockAllSeals_Click"
                        />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: Affection -->
            <TabItem Header="Affection">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock
                            Text="Affection determines dialogue choices, cutscenes, and who passes to Tidus in Blitz Ace:"
                            TextWrapping="Wrap"
                            Margin="4,2,4,8"
                            Foreground="{DynamicResource GrayBrush1}"
                        />
                        <DockPanel Margin="4,3">
                            <TextBlock VerticalAlignment="Center">Yuna</TextBlock>
                            <TextBox Name="TextAffection1" Tag="1" Width="80" HorizontalAlignment="Right" KeyDown="TextAffection_OnKeyDown" />
                        </DockPanel>
                        <DockPanel Margin="4,3">
                            <TextBlock VerticalAlignment="Center">Auron</TextBlock>
                            <TextBox Name="TextAffection2" Tag="2" Width="80" HorizontalAlignment="Right" KeyDown="TextAffection_OnKeyDown" />
                        </DockPanel>
                        <DockPanel Margin="4,3">
                            <TextBlock VerticalAlignment="Center">Kimahri</TextBlock>
                            <TextBox Name="TextAffection3" Tag="3" Width="80" HorizontalAlignment="Right" KeyDown="TextAffection_OnKeyDown" />
                        </DockPanel>
                        <DockPanel Margin="4,3">
                            <TextBlock VerticalAlignment="Center">Wakka</TextBlock>
                            <TextBox Name="TextAffection4" Tag="4" Width="80" HorizontalAlignment="Right" KeyDown="TextAffection_OnKeyDown" />
                        </DockPanel>
                        <DockPanel Margin="4,3">
                            <TextBlock VerticalAlignment="Center">Lulu</TextBlock>
                            <TextBox Name="TextAffection5" Tag="5" Width="80" HorizontalAlignment="Right" KeyDown="TextAffection_OnKeyDown" />
                        </DockPanel>
                        <DockPanel Margin="4,3">
                            <TextBlock VerticalAlignment="Center">Rikku</TextBlock>
                            <TextBox Name="TextAffection6" Tag="6" Width="80" HorizontalAlignment="Right" KeyDown="TextAffection_OnKeyDown" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </GroupBox>
</UserControl>
