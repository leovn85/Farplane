<UserControl
    x:Class="Farplane.FFX.EditorPanels.EquipmentPanel.EquipmentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="560"
    d:DesignWidth="500"
    mc:Ignorable="d"
>
    <UserControl.Resources>
        <Style x:Key="myHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <GroupBox Header="Equipment">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Inventory List & Actions -->
            <GroupBox Grid.Column="0" Header="Inventory">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView Name="ListEquipment" Grid.Row="0" SelectionChanged="SelectedEquipment_Changed" />

                    <StackPanel Grid.Row="1" Margin="2,4,2,0">
                        <Button
                            Name="ButtonDeleteItem"
                            Margin="0,1"
                            Click="ButtonDeleteItem_Click"
                            Content="Delete Item"
                        />
                        <Button
                            Name="ButtonSellItem"
                            Margin="0,1"
                            Click="ButtonSellItem_Click"
                            Content="Sell Selected Item"
                        />
                        <Expander Header="Bulk Sell" Margin="0,2,0,0" IsExpanded="False">
                            <StackPanel Margin="2">
                                <CheckBox
                                    Name="CheckPreserve4Slots"
                                    Content="Keep 4-slot gear"
                                    IsChecked="True"
                                    Margin="2"
                                />
                                <CheckBox
                                    Name="CheckPreserveRareAbilities"
                                    Content="Keep rare abilities"
                                    IsChecked="True"
                                    Margin="2"
                                />
                                <Button
                                    Name="ButtonBulkSell"
                                    Margin="0,4,0,2"
                                    Click="ButtonBulkSell_Click"
                                    Content="Sell Un-equipped Gear"
                                />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Column 1: Empty Slot Display -->
            <ContentControl Name="ContentNoItem" Grid.Column="1" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="This equipment slot is empty"
                        />
                        <Button
                            Margin="5"
                            Click="ButtonCreateNew_Click"
                            Content="Create New Item"
                        />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- Column 1: Equipment Editor Panel -->
            <ContentControl Name="ContentEditItem" Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Name="GroupEquipmentEditor" Header="Item Name">
                        <StackPanel Margin="5">
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Name" />
                                <Button
                                    Name="ButtonEquipmentName"
                                    Width="150"
                                    HorizontalAlignment="Right"
                                    Click="ButtonEquipmentName_OnClick"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Appearance" />
                                <Button
                                    Name="ButtonEquipmentAppearance"
                                    Width="150"
                                    HorizontalAlignment="Right"
                                    Click="ButtonEquipmentAppearance_OnClick"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Sell Price" />
                                <TextBlock
                                    Name="TextSellPrice"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold"
                                    Foreground="Goldenrod"
                                    Text="0 Gil"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Character" />
                                <ComboBox
                                    Name="ComboEquipmentCharacter"
                                    Width="120"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="ComboEquipmentCharacter_OnSelectionChanged"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Equipment Type" />
                                <ComboBox
                                    Name="ComboEquipmentType"
                                    Width="120"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="ComboEquipmentType_OnSelectionChanged"
                                >
                                    <ComboBoxItem>Weapon</ComboBoxItem>
                                    <ComboBoxItem>Armor</ComboBoxItem>
                                </ComboBox>
                            </DockPanel>

                            <GroupBox Header="Equipment Flags" Margin="2,4,2,2">
                                <WrapPanel>
                                    <CheckBox
                                        Name="CheckFlagCelestial"
                                        Content="Celestial"
                                        Margin="4,2"
                                        Checked="FlagCheckBox_Changed"
                                        Unchecked="FlagCheckBox_Changed"
                                    />
                                    <CheckBox
                                        Name="CheckFlagBrotherhood"
                                        Content="Brotherhood"
                                        Margin="4,2"
                                        Checked="FlagCheckBox_Changed"
                                        Unchecked="FlagCheckBox_Changed"
                                    />
                                    <CheckBox
                                        Name="CheckFlagSummon"
                                        Content="Summon"
                                        Margin="4,2"
                                        Checked="FlagCheckBox_Changed"
                                        Unchecked="FlagCheckBox_Changed"
                                    />
                                    <CheckBox
                                        Name="CheckFlagHidden"
                                        Content="Hidden"
                                        Margin="4,2"
                                        Checked="FlagCheckBox_Changed"
                                        Unchecked="FlagCheckBox_Changed"
                                    />
                                </WrapPanel>
                            </GroupBox>

                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Damage Formula" />
                                <ComboBox
                                    Name="ComboDamageFormula"
                                    Width="140"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="ComboDamageFormula_OnSelectionChanged"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Attack Power" />
                                <TextBox
                                    Name="TextAttackPower"
                                    Width="50"
                                    HorizontalAlignment="Right"
                                    KeyDown="TextAttackPower_OnKeyDown"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Critical Hit Percentage" />
                                <TextBox
                                    Name="TextCritChance"
                                    Width="50"
                                    HorizontalAlignment="Right"
                                    KeyDown="TextCritChance_OnKeyDown"
                                />
                            </DockPanel>
                            <DockPanel Margin="2">
                                <TextBlock VerticalAlignment="Center" Text="Ability Slots" />
                                <ComboBox
                                    Name="ComboEquipmentSlots"
                                    Width="60"
                                    HorizontalAlignment="Right"
                                    SelectionChanged="ComboEquipmentSlots_OnSelectionChanged"
                                >
                                    <ComboBoxItem>0</ComboBoxItem>
                                    <ComboBoxItem>1</ComboBoxItem>
                                    <ComboBoxItem>2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                    <ComboBoxItem>4</ComboBoxItem>
                                </ComboBox>
                            </DockPanel>

                            <GroupBox Margin="2,4,2,2" Header="Abilities">
                                <StackPanel Name="AbilityPanel" Margin="2">
                                    <Button Name="Ability0" Margin="2" Click="AbilityButton_Click" />
                                    <Button Name="Ability1" Margin="2" Click="AbilityButton_Click" />
                                    <Button Name="Ability2" Margin="2" Click="AbilityButton_Click" />
                                    <Button Name="Ability3" Margin="2" Click="AbilityButton_Click" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </GroupBox>
</UserControl>
