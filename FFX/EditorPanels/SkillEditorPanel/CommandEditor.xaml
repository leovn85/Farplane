<UserControl
    x:Class="Farplane.FFX.EditorPanels.SkillEditorPanel.CommandEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Farplane.FFX.EditorPanels.SkillEditorPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="600"
    mc:Ignorable="d"
>
    <DockPanel Margin="2">
        <!-- Top Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Margin="2" Content="Export .bin" Click="ButtonExport_Click" />
                <Button Margin="2" Content="Hot-Reload .bin" Click="ButtonHotReload_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="2,0,6,0">Kernel Table:</TextBlock>
                <ComboBox Name="ComboTable" Width="170" SelectionChanged="ComboTable_SelectionChanged">
                    <ComboBoxItem Content="Commands (command.bin)" IsSelected="True" />
                    <ComboBoxItem Content="Items (item.bin)" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Main Body -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search and List -->
            <DockPanel Grid.Column="0">
                <TextBox
                    Name="TextSearch"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,3"
                    TextChanged="TextSearch_TextChanged"
                    ToolTip="Search by command name or ID"
                />
                <ListView
                    Name="ListCommands"
                    SelectionChanged="ListCommands_OnSelectionChanged"
                />
            </DockPanel>

            <!-- Right: Details & SkillDataPanel -->
            <DockPanel Grid.Column="1" Margin="4,0,0,0">
                <GroupBox DockPanel.Dock="Top" Name="GroupHeader" Header="Action Name &amp; Description" Margin="0,0,0,4">
                    <StackPanel Margin="2">
                        <TextBlock Name="TextCommandName" FontWeight="Bold" FontSize="14" Margin="2" />
                        <TextBlock Name="Description" TextWrapping="Wrap" Margin="2" Foreground="{DynamicResource GrayBrush1}" />
                    </StackPanel>
                </GroupBox>

                <local:SkillDataPanel x:Name="SkillDataPanel" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
