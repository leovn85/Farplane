<UserControl
    x:Class="Farplane.FFX.EditorPanels.PartyPanel.PartyOverdrive"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="480"
    mc:Ignorable="d"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">
            <!-- Overdrive Status Bar -->
            <GroupBox Header="Overdrive">
                <DockPanel>
                    <DockPanel>
                        <TextBlock Margin="5,5,20,5" VerticalAlignment="Center">Overdrive Mode</TextBlock>
                        <ComboBox
                            Name="ComboCurrentOverdrive"
                            Width="110"
                            SelectionChanged="ComboCurrentOverdrive_OnSelectionChanged"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel HorizontalAlignment="Right">
                        <TextBlock Margin="5,5,10,5" VerticalAlignment="Center">Overdrive Level</TextBlock>
                        <TextBox
                            Name="TextOverdriveCurrent"
                            Width="40"
                            KeyDown="OverdriveTextBox_KeyDown"
                        />
                        <TextBlock Margin="5,5,5,5" VerticalAlignment="Center">/</TextBlock>
                        <TextBox
                            Name="TextOverdriveMax"
                            Width="40"
                            KeyDown="OverdriveTextBox_KeyDown"
                        />
                        <Button Margin="5,0,0,0" Click="ButtonMax_Click" Content="MAX" />
                    </DockPanel>
                </DockPanel>
            </GroupBox>

            <!-- Dynamic Learned Overdrives / Ronso Rages -->
            <GroupBox Name="GroupLearnedOverdrives" Header="Learned Overdrives &amp; Rages" Margin="0,4,0,0">
                <StackPanel Margin="2">
                    <DockPanel Name="PanelOverdriveCondition" Margin="2" Visibility="Collapsed">
                        <TextBlock Name="TextConditionLabel" VerticalAlignment="Center" Margin="4,2,8,2" FontWeight="SemiBold" />
                        <TextBox
                            Name="TextConditionValue"
                            Width="70"
                            HorizontalAlignment="Right"
                            KeyDown="TextConditionValue_KeyDown"
                        />
                    </DockPanel>
                    <TextBlock
                        Name="TextNoOverdrives"
                        Margin="4"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource GrayBrush1}"
                        Visibility="Collapsed"
                        Text="This character does not have unique unlockable Overdrives or Ronso Rages."
                    />
                    <WrapPanel Name="PanelLearnedCheckboxes" Margin="2" />
                    <Button
                        Name="ButtonUnlockAllOverdrives"
                        Margin="4,6,4,2"
                        Content="Unlock All Character Overdrives &amp; Rages"
                        Click="ButtonUnlockAllOverdrives_Click"
                    />
                </StackPanel>
            </GroupBox>

            <!-- Overdrive Modes & Turn Counters Grid -->
            <GroupBox Header="Overdrive Modes" Margin="0,4,0,0">
                <Grid Name="GridOverdrive">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
